# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor (Server Components, Server Actions, API routes)
# NUNCA exponer al cliente ni commitear el valor real
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics
# GA4: obtener del panel de Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity: se configura vía script en layout.tsx o GTM
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# --- Registro de campo por voz (servicios locales, todos opcionales) ---
# Tienen defaults locales; sobrescribir solo si cambiás puertos/host.
# WHISPER_URL=http://localhost:5001/transcribe
# OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=qwen3:8b
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/procesar-audio
# SELF_URL=http://localhost:3000
